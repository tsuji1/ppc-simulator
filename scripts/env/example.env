# Copy this file and replace the input paths with files available on your machine.
RULEFILE="/path/to/rules/example.rule"
TRACES=(
  "/path/to/traces/example.pcap"
)

# Basic UnifiedCache run. Values are log2 capacities and refbits.
CACHE_TYPE="UnifiedCache"
CAPACITY_START=10
CAPACITY_END=14
CAPACITY_STEP=2
WAY=8
CACHE_INDEX_TYPE=5
REFBITS_START=24
REFBITS_END=24
REFBITS_STEP=1
CACHENUM=1
SKIP_INDEX=-1
MAX_PROCESS=100000

# Safe defaults for a small local run. Enable database updates only when needed.
ENABLE_DBUPDATE=false
ENABLE_BENCH=false
ENABLE_RECORD_CACHE_HIT=false
USE_SUDO=false
