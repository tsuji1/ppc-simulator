#!/usr/bin/env python3
import argparse
import csv
from pathlib import Path


PREFIX_LENGTHS = (8, 16, 24, 32)
CONCENTRATION_FIELDS = (
    "unique_prefixes",
    "top1_ratio",
    "top5_ratio",
    "top10_ratio",
    "top50_ratio",
    "top100_ratio",
)


def parse_args():
    parser = argparse.ArgumentParser(
        description="Compare destination prefix distribution reports generated by analyze_dst_prefix_distribution."
    )
    parser.add_argument(
        "--input",
        action="append",
        required=True,
        help="Report input as LABEL=DIR. If LABEL= is omitted, the directory basename is used.",
    )
    parser.add_argument("--output-dir", required=True, help="Directory for comparison CSV/Markdown output.")
    parser.add_argument("--top-n", type=int, default=20, help="Top prefixes per trace to include in union CSVs.")
    return parser.parse_args()


def parse_input(value):
    if "=" in value:
        label, directory = value.split("=", 1)
        label = label.strip()
    else:
        directory = value
        label = Path(directory).name
    if not label:
        raise ValueError(f"empty label in --input {value!r}")
    return label, Path(directory)


def read_key_value_csv(path):
    result = {}
    with path.open(newline="") as file:
        reader = csv.DictReader(file)
        for row in reader:
            result[row["metric"]] = row["value"]
    return result


def read_concentration(path):
    result = {}
    with path.open(newline="") as file:
        reader = csv.DictReader(file)
        for row in reader:
            result[int(row["prefix_length"])] = row
    return result


def read_prefix_csv(path):
    rows = []
    with path.open(newline="") as file:
        reader = csv.DictReader(file)
        for row in reader:
            row["rank"] = int(row["rank"])
            row["count"] = int(row["count"])
            row["ratio"] = float(row["ratio"])
            rows.append(row)
    return rows


def read_top_prefixes(path, top_n):
    prefixes = []
    with path.open(newline="") as file:
        reader = csv.DictReader(file)
        for row in reader:
            prefixes.append(row["prefix"])
            if len(prefixes) >= top_n:
                break
    return prefixes


def read_selected_prefixes(path, selected_prefixes):
    rows = {}
    if not selected_prefixes:
        return rows
    remaining = set(selected_prefixes)
    with path.open(newline="") as file:
        reader = csv.DictReader(file)
        for row in reader:
            prefix = row["prefix"]
            if prefix not in remaining:
                continue
            row["rank"] = int(row["rank"])
            row["count"] = int(row["count"])
            row["ratio"] = float(row["ratio"])
            rows[prefix] = row
            remaining.remove(prefix)
            if not remaining:
                break
    return rows


def write_csv(path, fieldnames, rows):
    with path.open("w", newline="") as file:
        writer = csv.DictWriter(file, fieldnames=fieldnames)
        writer.writeheader()
        writer.writerows(rows)


def build_inputs(raw_inputs):
    inputs = []
    for raw in raw_inputs:
        label, directory = parse_input(raw)
        summary_path = directory / "summary.csv"
        concentration_path = directory / "concentration.csv"
        if not summary_path.exists():
            raise FileNotFoundError(summary_path)
        if not concentration_path.exists():
            raise FileNotFoundError(concentration_path)
        inputs.append(
            {
                "label": label,
                "dir": directory,
                "summary": read_key_value_csv(summary_path),
                "concentration": read_concentration(concentration_path),
            }
        )
    return inputs


def write_concentration_comparison(output_dir, inputs):
    rows = []
    for item in inputs:
        for prefix_length, concentration in sorted(item["concentration"].items()):
            row = {
                "trace": item["label"],
                "prefix_length": prefix_length,
            }
            for field in CONCENTRATION_FIELDS:
                row[field] = concentration[field]
            rows.append(row)
    path = output_dir / "comparison_concentration.csv"
    write_csv(path, ("trace", "prefix_length", *CONCENTRATION_FIELDS), rows)
    return path


def write_top_union_csvs(output_dir, inputs, top_n):
    paths = []
    for prefix_length in PREFIX_LENGTHS:
        selected_prefixes = set()
        for item in inputs:
            prefix_path = item["dir"] / f"prefix_{prefix_length}.csv"
            if not prefix_path.exists():
                continue
            selected_prefixes.update(read_top_prefixes(prefix_path, top_n))

        if not selected_prefixes:
            continue

        selected_by_trace = {}
        for item in inputs:
            prefix_path = item["dir"] / f"prefix_{prefix_length}.csv"
            if prefix_path.exists():
                selected_by_trace[item["label"]] = read_selected_prefixes(prefix_path, selected_prefixes)

        def sort_key(prefix):
            max_ratio = max(
                selected_by_trace.get(item["label"], {}).get(prefix, {}).get("ratio", 0.0)
                for item in inputs
            )
            return (-max_ratio, prefix)

        rows = []
        for prefix in sorted(selected_prefixes, key=sort_key):
            row = {"prefix_length": prefix_length, "prefix": prefix}
            for item in inputs:
                data = selected_by_trace.get(item["label"], {}).get(prefix)
                row[f"{item['label']}_count"] = data["count"] if data else 0
                row[f"{item['label']}_ratio"] = f"{data['ratio']:.12f}" if data else "0.000000000000"
                row[f"{item['label']}_rank"] = data["rank"] if data else ""
            rows.append(row)

        fieldnames = ["prefix_length", "prefix"]
        for item in inputs:
            fieldnames.extend([f"{item['label']}_count", f"{item['label']}_ratio", f"{item['label']}_rank"])
        path = output_dir / f"prefix_{prefix_length}_top{top_n}_union.csv"
        write_csv(path, fieldnames, rows)
        paths.append(path)
    return paths


def metric(summary, name, default=""):
    return summary.get(name, default)


def write_markdown(output_dir, inputs, concentration_path, union_paths, top_n):
    path = output_dir / "dst_prefix_distribution_comparison.md"
    lines = []
    lines.append("# Destination prefix distribution comparison")
    lines.append("")
    lines.append("This compares non-anonymized traces by destination IPv4 prefix distribution.")
    lines.append("")

    lines.append("## Inputs")
    lines.append("")
    lines.append("| trace | IPv4 packets | non-IPv4 packets | parse errors | report |")
    lines.append("| --- | ---: | ---: | ---: | --- |")
    for item in inputs:
        report = item["dir"] / "summary.md"
        lines.append(
            "| {label} | {ipv4} | {non_ipv4} | {parse_errors} | `{report}` |".format(
                label=item["label"],
                ipv4=metric(item["summary"], "ipv4_packets"),
                non_ipv4=metric(item["summary"], "non_ipv4_packets"),
                parse_errors=metric(item["summary"], "parse_error_packets"),
                report=report,
            )
        )
    lines.append("")

    lines.append("## Concentration")
    lines.append("")
    lines.append("Ratios are packet-count shares within IPv4 packets.")
    lines.append("")
    lines.append("| prefix length | trace | unique prefixes | top1 | top5 | top10 | top50 | top100 |")
    lines.append("| ---: | --- | ---: | ---: | ---: | ---: | ---: | ---: |")
    for prefix_length in PREFIX_LENGTHS:
        for item in inputs:
            row = item["concentration"].get(prefix_length)
            if not row:
                continue
            lines.append(
                "| /{plen} | {label} | {unique} | {top1:.4f} | {top5:.4f} | {top10:.4f} | {top50:.4f} | {top100:.4f} |".format(
                    plen=prefix_length,
                    label=item["label"],
                    unique=int(row["unique_prefixes"]),
                    top1=float(row["top1_ratio"]),
                    top5=float(row["top5_ratio"]),
                    top10=float(row["top10_ratio"]),
                    top50=float(row["top50_ratio"]),
                    top100=float(row["top100_ratio"]),
                )
            )
    lines.append("")

    lines.append("## Files")
    lines.append("")
    lines.append(f"- `{concentration_path}`: normalized concentration table across traces.")
    for union_path in union_paths:
        lines.append(f"- `{union_path}`: union of per-trace top-{top_n} prefixes for that prefix length.")
    lines.append("")

    lines.append("## Rerun")
    lines.append("")
    lines.append("```bash")
    lines.append("cd /home/yuzugon/osada-ppc-simulator")
    for item in inputs:
        trace = metric(item["summary"], "trace")
        prefix_lengths = metric(item["summary"], "prefix_lengths", "8,16,24,32")
        lines.append("sudo ./scripts/analyze_dst_prefix_distribution \\")
        lines.append(f"  --trace {trace} \\")
        lines.append(f"  --prefix-lengths {prefix_lengths} \\")
        lines.append(f"  --output-dir {item['dir']}")
        lines.append("")
    compare_parts = ["./scripts/compare_dst_prefix_distribution \\"]
    for item in inputs:
        compare_parts.append(f"  --input {item['label']}={item['dir']} \\")
    compare_parts.append(f"  --top-n {top_n} \\")
    compare_parts.append(f"  --output-dir {output_dir}")
    lines.extend(compare_parts)
    lines.append("```")
    lines.append("")

    path.write_text("\n".join(lines))
    return path


def main():
    args = parse_args()
    if args.top_n <= 0:
        raise SystemExit("--top-n must be positive")
    output_dir = Path(args.output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)

    inputs = build_inputs(args.input)
    concentration_path = write_concentration_comparison(output_dir, inputs)
    union_paths = write_top_union_csvs(output_dir, inputs, args.top_n)
    markdown_path = write_markdown(output_dir, inputs, concentration_path, union_paths, args.top_n)
    print(f"wrote {markdown_path}")


if __name__ == "__main__":
    main()
